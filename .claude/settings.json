{
  "permissions": {
    "allow": [
      "Bash(node scripts/verify.mjs)",
      "Bash(node scripts/verify.mjs *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/test-before-push.mjs\"",
            "timeout": 600,
            "statusMessage": "Prüfe Build, Tests und OpenAPI-Contract vor git push …"
          }
        ]
      }
    ]
  }
}
